<Window x:Class="NDDownload.InstallHelp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NDDownload"
        mc:Ignorable="d"
        Title="安装完成之后 请在菜单栏上找 NDBox " Height="675" Width="810" WindowStyle="ToolWindow">
    <DockPanel Margin="0,0,0,0" LastChildFill ="True" >
        <ScrollViewer x:Name="textBoxScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility ="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBox x:Name="textBox" Margin="5 2 5 2" IsReadOnly="True" />
        </ScrollViewer>

        <!--<Image Source="/ndboxInstall.png" /> -->
        <!--<Image Source="/max_2022.png" Height="333" Margin="0 20 0 0"/>-->
    </DockPanel>
</Window>
