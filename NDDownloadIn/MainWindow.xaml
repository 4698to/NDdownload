<Window x:Class="NDDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NDDownload"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:gifd="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="600"
        ResizeMode="CanResize"
        Closed="Window_Closed"
        MinWidth="690"
        MinHeight="600" Icon="./imgae/mao.ico"
        >
    <Window.Resources>
        <Style x:Key="text0" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="GreenYellow" />
            <Setter Property="Foreground" Value="CadetBlue" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="text4" TargetType="{x:Type TextBlock}" >
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="buttons" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border CornerRadius="3" BorderBrush="#037AA6" BorderThickness="1" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="100" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TabControl MinWidth ="670" MinHeight="530" Grid.Row="0" Grid.Column="0" BorderThickness="0 1 0 0" >
            <TabItem Header="服务器" Style="{DynamicResource TabItemStyle}">
                <!--<DockPanel LastChildFill="False">-->
                    <!-- <Image gifd:ImageBehavior.AnimatedSource="{Binding ShowGif}" DockPanel.Dock="Top" HorizontalAlignment="Center" VerticalAlignment="Top"/>-->
                    
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions >
                        <RowDefinition Height="7*" />
                        <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Image gifd:ImageBehavior.AnimatedSource="{Binding ShowGif}" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        
                        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" Background="GreenYellow" Width="250" VerticalAlignment="Center">
                            <Label x:Name="labelShowServer" Content="动作工具内网资源服务器" Height="30"  HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        
                    </Grid>
                <!--</DockPanel>-->
            </TabItem>

            <TabItem Header="{Binding DownTitle}" Style="{DynamicResource TabItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="61*"/>
                        <ColumnDefinition Width="274*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" x:Name="r0" />
                        <RowDefinition Height="2" x:Name="r1"/>
                        <RowDefinition Height="2" x:Name="r2"/>

                        <RowDefinition x:Name="r3" Height="*"  MinHeight="200" MaxHeight="450" />
                        <RowDefinition x:Name="r4" Height="180*" />

                        <RowDefinition Height="30" x:Name="r5"/>
                        <RowDefinition Height="55" x:Name="r6"/>
                        <RowDefinition Height="Auto" x:Name="r7"/>

                    </Grid.RowDefinitions>

                    <ProgressBar x:Name="progerss" Height="30" Grid.Row="0" Value="{Binding ProgressValue}" Grid.ColumnSpan="2" Margin="0,2,0,3"/>
                    <!--<TextBlock x:Name="text1" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding localVersionMessage}" Style="{StaticResource text0}" />-->
                    <!--<TextBlock x:Name="text2" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding remoteVersionMessage}" Style="{StaticResource text0}"/>-->
                    <!--3dsMax版本选择-->
                    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" >
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                            <TextBlock x:Name="text4" Text="请选择需要安装的 3ds Max 版本" Style="{StaticResource text4}" Margin="10 0 0 0"/>
                            <CheckBox x:Name="select_all" Content="全选" IsChecked="False" Margin="10 2 0 2" Click="select_all_Checked" />
                            <ListBox x:Name="listBox" ItemsSource="{Binding MaxInstallSelect}" HorizontalAlignment="Left" Margin="10 0 0 25" Width="210" >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="checkbox" Grid.Column="0" IsChecked="{Binding isSelected}" />
                                            <TextBlock x:Name="textblock" Text="{Binding Name}" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <ScrollViewer x:Name="textBoxScroll" DockPanel.Dock="Right" VerticalScrollBarVisibility ="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="textBox"  Text="{Binding Message}"  Margin="20 2 20 2"/>
                        </ScrollViewer>
                    </DockPanel>
                    <!--下载资源选择-->
                    <DockPanel x:Name="li" Grid.Row="4" LastChildFill="True" Grid.ColumnSpan="2" Margin="0,0,0,30" Grid.RowSpan="2" >
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" VerticalAlignment="Center">
                            <TextBlock x:Name="ttt" Text="选择需要安装内容"  Style="{StaticResource text4}" Margin="10 2 0 2" />
                            <CheckBox x:Name="select_file_all" Content="全选" IsChecked="False" Margin="10 4 0 0" Click="select_all_file_Checked" />
                            <TextBlock x:Name="remote" Text="服务器内容版本:" Style="{StaticResource text4}" Margin="10 0 0 0"/>
                            <TextBlock x:Name="remote_ver" Text="{Binding RemoteVers}" Style="{StaticResource text4}" Margin="10 0 0 0"/>
                            <TextBlock x:Name="text1" Margin="20 0 0 0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding localVersionMessage}" Style="{StaticResource text4}" />

                        </StackPanel>
                        <ListBox x:Name="downitems" ItemsSource="{Binding FileDownloadSelect}" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Visible" Margin="10 0 0 0" >
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="listbackground" BorderThickness="0" >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="c0" Width="30" MaxWidth="30"/>
                                                <ColumnDefinition x:Name="c1" Width="150" MaxWidth="200"/>
                                                <ColumnDefinition x:Name="c2" Width="60" MaxWidth="60"/>
                                                <ColumnDefinition x:Name="c3" Width="60" MaxWidth="60"/>
                                                <ColumnDefinition x:Name="c4" Width="40" MaxWidth="60"/>
                                                <ColumnDefinition x:Name="c5" Width="200*"/>
                                                <ColumnDefinition x:Name="c6" Width="50" MaxWidth="50"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox x:Name="downfile_select" Grid.Column="0" IsChecked="{Binding isSelected}" IsEnabled ="{Binding IsEnabled}"/>
                                            <Border x:Name="name_border" BorderThickness="0" Grid.Column="1" >
                                                <TextBlock x:Name="downfile_name" Text="{Binding Name}" Margin="5 0 10 0"/>
                                            </Border>
                                            <TextBlock x:Name="downfile_about" Text="{Binding About}" Grid.Column="5" Margin="10 0 0 0" Grid.ColumnSpan="2"/>
                                            <TextBlock x:Name="help" Grid.Column="4" Margin="5 0 0 0">
                                            <Hyperlink NavigateUri="{Binding helplink}" Click="Hyperlink_Click" >
                                                帮助...
                                            </Hyperlink>
                                            </TextBlock>
                                            <!--<TextBlock x:Name="isdone" Grid.Column="6" Margin="15 0 0 0" />-->
                                            <TextBlock x:Name="oldVer" Text="{Binding oldVersion}" Grid.Column="2" Margin="15 0 0 0" Padding="3 0 3 0" />
                                            <TextBlock x:Name="Ver" Text="{Binding Version}" Grid.Column="3" Margin="15 0 0 0" Padding="3 0 3 0"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding isDone}" Value="true">
                                            <Setter Property="Background" TargetName="listbackground" Value="#FFA0EB8C" />
                                            <!--<Setter Property="Text" TargetName="isdone" Value="已安装"/> 
                                <Setter Property="Background" TargetName="isdone" Value="#FFDDFFD9"/>-->
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding quick}" Value="true">
                                            <Setter Property="Background" TargetName="name_border" Value="#FFF1E158" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding quick}" Value="false">
                                            <Setter Property="Background" TargetName="name_border" Value="#FFBEE0FE" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding isUpdate}" Value="true">
                                            <Setter Property="Foreground" TargetName="Ver" Value="#FF4FACD5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding isUpdate}" Value="false">
                                            <Setter Property="Foreground" TargetName="Ver" Value="Black" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding hasUrl}" Value="false">
                                            <Setter Property="Visibility" TargetName="help" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" >
                        <Rectangle  Stroke="#FFBEE0FE" Fill="#FFBEE0FE" Width="12" Height="12" Margin="10 0 0 0"/>
                        <TextBlock  Text="请关闭 3ds Max 之后再安装或者更改" Margin="10,0,0,0"  VerticalAlignment="Center"/>
                        <Rectangle  Stroke="#FFF1E158" Fill="#FFF1E158" Width="12" Height="12" Margin="15 0 0 0"/>
                        <TextBlock  Text="可直接安装或者更改" Margin="10,0,0,0"  VerticalAlignment="Center"/>
                        <Rectangle  Stroke="#FFBEE0FE" Fill="#FFA0EB8C" Width="12" Height="12" Margin="15 0 0 0"/>
                        <TextBlock  Text="已安装" Margin="10,0,0,0"  VerticalAlignment="Center"/>
                    </StackPanel>
                    <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,10" Grid.RowSpan="1" >
                        <Button x:Name="btn_uninstall" DockPanel.Dock="Left" IsEnabled="{Binding CanControl}" Click="btn_uninstall_Click" Width ="220" Height="35" HorizontalAlignment="Left" Margin="50 0 0 0" >
                            <TextBlock Text="卸载" Style="{StaticResource text4}"/>
                        </Button>

                        <Button x:Name="btn_do"  DockPanel.Dock="Right" IsEnabled="{Binding CanControl}" Click="btn_do_Click"  Width ="220" Height="35"  HorizontalAlignment="Right" Margin="0 0 50 0" >
                            <TextBlock Text="{Binding ButtonText}" Style="{StaticResource text4}"/>
                        </Button>
                    </DockPanel>
                    <Expander Header="离线安装" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Background="#FFBEE0FE">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="temp_path" Text="{Binding UserResourceDirectory}" Width="Auto" Grid.Column="0" Grid.Row="0" Margin="10 5 0 5" IsReadOnly="True" />
                            <Button x:Name="select_path" Width="80"  Height="24" Content="选择资源目录" Grid.Column="1" Grid.Row="0" Click="Button_select_path_Click"/>
                            <Button x:Name="replace_resources" Width ="220" Height="35" Content="安装离线资源" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="0 5 0 5" Click="replace_resources_Click" />
                            
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="库设置" Style="{DynamicResource TabItemStyle}">
                <StackPanel>
                    
                    <StackPanel Orientation="Vertical" Margin="0 5 0 5">
                        <TextBlock Text="设置后关闭天晴盒子安装器（关闭时自动保存配置），然后重启 3dsMax 生效。"  Style="{StaticResource text4}" Margin="10 0 0 0" />
                        <TextBlock Text="默认选项不可设置。"  Style="{StaticResource text4}" Margin="10 0 0 0" />
                    </StackPanel>

                    <Expander Header="文件夹工具库" IsExpanded="True"  Background="#FFFFBFC9">
                    <Grid >
                        <!--列-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!--行-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="30"/>
                            
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="1" >
                                <TextBlock DockPanel.Dock="Left" Text="只识别第一层文件夹；ms mse 后缀名的脚本，脚本同名的 txt 为工具说明。" Height="20" Style="{StaticResource text4}" Margin="10 0 0 0"/>
                                <Button DockPanel.Dock="Right" x:Name="addnewpath"  Content="添加" Width="40" Height="20" HorizontalAlignment="Right" Margin="0,0,25,0" Click="addnewpath_Click"/>
                        </DockPanel>
                        <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True" Margin="0 10 0 0">
                            <ListBox x:Name="listBoxPath" DockPanel.Dock="Bottom" ItemsSource="{Binding ScriptPaths}" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Visible"  MinHeight="150">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!--ShowGridLines="True"=-->
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" MaxWidth="30" />
                                                <ColumnDefinition Width="400*"/>
                                                <ColumnDefinition Width="45" MaxWidth="45" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="checkbox" Grid.Column="0" IsChecked="{Binding Select}" />
                                                <TextBlock x:Name="textblock" Text="{Binding Path}" Grid.Column="1" />
                                            <Button x:Name="remove" Content="移除" Grid.Column="2" Height="20" Width="40" IsEnabled ="{Binding Edit}" HorizontalAlignment="Right" FlowDirection="RightToLeft" Click="remove_Click"/>
                                        </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="false">
                                                    <Setter Property="TextDecorations" TargetName="textblock" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            
                        </DockPanel>

                        
                </Grid>
                </Expander>
                    <Expander Header ="XML工具库" Background="#FFBCE292">
                        <Grid >
                            <!--列-->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <!--行-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True" Margin="0 10 0 0">
                                <ListBox x:Name="listBoxPath1" DockPanel.Dock="Bottom" ItemsSource="{Binding XMLPaths}" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Visible"  MinHeight="150">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!--ShowGridLines="True"=-->
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" MaxWidth="30" />
                                                    <ColumnDefinition Width="400*"/>
                                                    <ColumnDefinition Width="45" MaxWidth="45" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="checkbox" Grid.Column="0" IsChecked="{Binding Select}" />
                                                <TextBlock x:Name="textblock_xml" Text="{Binding Path}" Grid.Column="1" />
                                                <Button x:Name="removeXMLPath" Content="移除" Grid.Column="2" Height="20" Width="40" IsEnabled ="{Binding Edit}" HorizontalAlignment="Right" FlowDirection="RightToLeft" Click="removeXMLPath_Click_1"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="false">
                                                    <Setter Property="TextDecorations" TargetName="textblock_xml" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </DockPanel>

                            <DockPanel Grid.Row="1" Grid.Column="0" >
                                <TextBlock DockPanel.Dock="Left" Text="" Style="{StaticResource text4}" Margin="10 0 0 0"/>
                                <Button DockPanel.Dock="Right" x:Name="addNewXml"  Content="添加" Width="40" Height="20" HorizontalAlignment="Right" Margin="0,0,25,0" Click="addNewXml_Click" />
                            </DockPanel>
                        </Grid>
                    </Expander>
                    <DockPanel Margin="0 5 0 0 ">
                        <TextBlock DockPanel.Dock="Left" Text="Version:0.2" x:Name="show_version" Height="20" Style="{StaticResource text4}" Margin="10 0 0 0"/>
                        <Button DockPanel.Dock="Right" x:Name="open_temp_path" Content="打开临时文件" Width="120" Height="20" HorizontalAlignment="Right" Margin="0,0,25,0" Click="open_temp_path_Click"/>
                    </DockPanel>
            </StackPanel>
                
            </TabItem>
            <TabItem Header="更新日志" Style="{DynamicResource TabItemStyle}" >
                <DockPanel Margin="0,0,0,0" LastChildFill ="True" >
                    <ScrollViewer x:Name="aboutScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility ="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="abouttextBox" IsReadOnly="True" Text="{Binding AboutText}"/>
                    </ScrollViewer>

                    <!--<Image Source="/ndboxInstall.png" /> -->
                    <!--<Image Source="/max_2022.png" Height="333" Margin="0 20 0 0"/>-->
                </DockPanel>

            </TabItem>
            
        </TabControl>
        
        <Grid  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="122"/>
                <ColumnDefinition Width="142*"/>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="341*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="0 1 0 0" BorderBrush="#FF8D8D8D" Margin="0,15,0,0" />
            <TextBlock Grid.Column="1" Text="" Margin="5,5,5,0" >
                <Hyperlink NavigateUri="http://anim.nd.com.cn/" Click="Hyperlink_Click" >anim.nd.com.cn</Hyperlink>
            </TextBlock>
            <Border Grid.Column="2" BorderThickness="0 1 0 0" BorderBrush="#FF8D8D8D" Margin="0 15 0 0
                    " Grid.ColumnSpan="3" />
        </Grid>

    </Grid>

</Window>
